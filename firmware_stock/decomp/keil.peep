// Peephole rules steering SDCC toward Keil C51's encoding choices.
//
// Every rule here is validated the only way that matters: the emitted bytes
// are diffed against the stock image by tools/match51.py. A rule that breaks
// a function shows up immediately as a DIFF, so "is this transform safe?"
// reduces to "do all candidates still match?".

// SDCC emits the 3-byte "ANL direct,#imm" form against ACC where the 2-byte
// "ANL A,#imm" form exists. Same for ORL and XRL.
replace { anl acc,#%1 } by { anl a,#%1 }
replace { orl acc,#%1 } by { orl a,#%1 }
replace { xrl acc,#%1 } by { xrl a,#%1 }

// Keil zeroes a direct byte via the accumulator (CLR A + MOV dir,A, 3 bytes)
// rather than MOV dir,#0 (3 bytes). Size-neutral, and it is what the original
// emitted. Clobbers A; any function where that matters will fail its match.
replace { mov %1,#0x00 } by { clr a
	mov %1,a }

// SDCC does not commute XOR/OR/AND against a constant: it loads the constant
// into A and the variable into B, costing a push/pop pair around five
// instructions. Keil emitted the single 2-byte "XRL A,#imm". This collapses
// the whole sequence and is what makes comparison idioms match.
replace {
	push	b
	mov	b,a
	mov	a,#%1
	xrl	a,b
	pop	b
} by {
	xrl	a,#%1
}
replace {
	push	b
	mov	b,a
	mov	a,#%1
	orl	a,b
	pop	b
} by {
	orl	a,#%1
}
replace {
	push	b
	mov	b,a
	mov	a,#%1
	anl	a,b
	pop	b
} by {
	anl	a,#%1
}

// SDCC increments a direct byte through the accumulator
// (mov a,dir / inc a / mov dir,a, 5 bytes). Keil used the direct INC.
// When A is dead afterwards that is a plain 2-byte INC; when the value is
// still needed -- as in the 16-bit pointer advance, where the low byte feeds
// the JNZ -- it is INC dir + MOV A,dir, 4 bytes. The notUsed guard picks the
// right one. Order matters: the shorter rule must be tried first.
replace {
	mov	a,%1
	inc	a
	mov	%1,a
} by {
	inc	%1
} if notUsed('a')

replace {
	mov	a,%1
	inc	a
	mov	%1,a
} by {
	inc	%1
	mov	a,%1
}

// SDCC copies the accumulator into R7 before comparing against a constant.
// Keil compared A directly, saving the copy.
// The notUsed('r7') guard was dropped: SDCC's liveness analysis is
// conservative and refuses to fire inside functions with many branches, which
// is exactly where the rule is needed. Dropping it is safe here because every
// candidate is re-verified against the stock bytes, and any function where R7
// really is live afterwards stops matching.
replace {
	mov	r7,a
	cjne	r7,#%1,%2
} by {
	cjne	a,#%1,%2
}

// SDCC commutes an equality test against a variable: it loads the CONSTANT
// into A and compares with "CJNE A,direct" where Keil loaded the VARIABLE and
// used "CJNE A,#imm". Both are 5 bytes; only the operand order differs.
//
// Caveat: CJNE sets carry from (first operand) < (second operand), so
// swapping the operands inverts C. That is safe only where the carry is not
// consumed afterwards, which the byte match verifies.
replace {
	mov	a,#%1
	cjne	a,%2,%3
} by {
	mov	a,%2
	cjne	a,#%1,%3
}

// SDCC evaluates an unsigned ">= const" by emitting CJNE against a label that
// is the very next instruction, using it purely for the carry side effect.
// Keil used SETB C + SUBB A,#const-1, which is the same three bytes and the
// same carry, but destroys A. Only valid where A is dead, which the byte
// match verifies.
replace {
	cjne	a,#0x02,%1
%1:
} by {
	setb	c
	subb	a,#0x01
}

// Same family, next constant up. The peephole language has no arithmetic on
// immediates, so "cjne a,#N" -> "subb a,#N-1" needs one row per N rather than
// one general rule. Each row is still exact, and an unused row simply never
// fires; add another when a new constant turns up. N=3 is std_get_interface,
// which rejects wIndex > 2.
replace {
	cjne	a,#0x03,%1
%1:
} by {
	setb	c
	subb	a,#0x02
}

// SDCC folds "test bit, then clear it" into JBC (test-and-clear) and inverts
// the branch. Keil emitted the naive JNB + CLR. The earlier attempt at this
// rule failed because it named two labels; matching only the one that is
// defined inside the window works.
replace {
	jbc	%1,%2
	sjmp	%3
%2:
	ret
} by {
	jnb	%1,%3
	clr	%1
	ret
}

// After "clr a / mov dir,a" the accumulator is still zero, so an immediately
// following "clr a" is dead. Keil kept A=0 alive across a whole run of stores.
replace {
	clr	a
	mov	%1,a
	clr	a
} by {
	clr	a
	mov	%1,a
}


// Same compare family again, via SDCC's other encoding of it. For "> const"
// SDCC prefers ADD A,#0xff-const (two bytes, carry out) over CJNE. Keil always
// used the SETB C / SUBB form.
//
// The two carry senses are OPPOSITE, and the conditional branch has to be
// rewritten with them or the test inverts. ADD A,#0xff-N sets carry when
// A > N; SETB C + SUBB A,#N borrows when A <= N. Rewriting only the arithmetic
// and leaving the JC alone silently reverses the comparison -- which is what
// the first draft of this rule did, and what the byte match caught.
replace {
	add	a,#0xff - 0x02
	jc	%1
} by {
	setb	c
	subb	a,#0x02
	jnc	%1
}
