# USBCTL — three writes, all intentional and cited:
#   assign 0x00 (main.c): defensive disconnect at top of main(), and the
#     same write in the deferred enter-DFU path before the signature is
#     invalidated. POLICY §2 carve-out A. Matches Rev 20 disasm 0x08E5
#     (master init) and safety_net's top-of-main disconnect. No-op on the
#     expected boot paths (post-DFU-manifest USBCTL=0, cold boot USBCTL=0).
#   or 0x80 (usb.c): CONN alone at cold init — mirrors Rev 20 0x0AE2.
#   or 0xC0 (usb.c): RMW attach — CONN + FEN together. FEN required per
#     datasheet §6.5.1.4 ("UBM ignores all USB transactions" when FEN=0).
#     usb_init is called at boot and re-called from VEC_RSTR, so both
#     paths reliably set FEN. Rev 20 splits this the same way: |=0x80 at
#     cold init 0x0AE2 and |=0xC0 in the RSTR handler at 0x0F72.
0xfffc  assign    0x00    # main
0xfffc  or        0x80    # usb
0xfffc  or        0xc0    # usb
# USBIMSK — 0xF5 = RSTR|SUSR|RESR|SOF|SETUP|STPOW (datasheet §6.5.1.3:
#   7=RSTR 6=SUSR 5=RESR 4=SOF 3=PSOF 2=SETUP 1=rsvd 0=STPOW).
#   Was 0xE5, the same set without SOF. Telemetry block 5 measured
#   tlm_sof_count == 0 on hardware because of it. Rev 20 uses 0x9F, which
#   also enables SOF; we keep SUSR/RESR that Rev 20 omits, and still leave
#   PSOF masked.
0xfffd  or        0xf5    # usb
0xffff  assign    0x00    # usb
0xffff  runtime   -       # usb
